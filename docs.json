{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Split Tester",
  "description": "A/B testing for Shopify. Run experiments on themes, prices, content, and more.",
  "colors": {
    "primary": "#5b5bd6",
    "light": "#7c7ce8",
    "dark": "#4a4ab8"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "icon": "layout-dashboard",
          "href": "https://amused-bravery-production-e9f7.up.railway.app/dashboard"
        },
        {
          "anchor": "Support",
          "icon": "life-buoy",
          "href": "mailto:support@splittester.com"
        }
      ]
    },
    "directory": "card",
    "groups": [
      {
        "group": "Getting Started",
        "icon": "rocket",
        "expanded": true,
        "pages": [
          "getting-started/quickstart",
          "getting-started/how-it-works"
        ]
      },
      {
        "group": "Experiments",
        "icon": "flask-conical",
        "expanded": true,
        "pages": [
          "experiments/creating",
          "experiments/types",
          "experiments/traffic-allocation",
          "experiments/segments"
        ]
      },
      {
        "group": "Results",
        "icon": "chart-bar",
        "expanded": true,
        "pages": [
          "results/overview",
          "results/metrics",
          "results/significance"
        ]
      },
      {
        "group": "Theme Setup",
        "icon": "paintbrush",
        "expanded": true,
        "pages": [
          "setup/app-embed",
          "setup/variant-content",
          "setup/template-tests"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Open Dashboard",
      "href": "https://amused-bravery-production-e9f7.up.railway.app/dashboard"
    }
  },
  "footer": {
    "socials": {}
  }
}
